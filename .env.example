# ============================================================
# Talkmart backend — mühit dəyişənləri nümunəsi
# Bu faylı .env kimi kopyalayın və dəyərləri doldurun.
# HEÇ VAXT real sirləri bu fayla yazmayın — bu fayl git-ə commit olunur.
# ============================================================

# --- Server ---
PORT=5000
# Vergüllə ayrılmış icazəli originlər (boşdursa "*")
ALLOWED_ORIGINS=

# İstifadəçinin real IP-sini oxumaq üçün (rate limit buna əsaslanır):
#   false     → server birbaşa internetə açıqdır (proxy yoxdur)
#   1         → bir proxy arxasında (yalnız Nginx VƏ YA yalnız Cloudflare)
#   2         → Cloudflare → Nginx → Node
#   loopback  → yalnız eyni maşındakı Nginx-ə etibar et
TRUST_PROXY=1

# --- Verilənlər bazası / keş ---
MONGO_URI=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
# Minimum 32 simvol. Yaratmaq üçün: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Cloudflare R2 ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=Talkmart
FROM_EMAIL=
REPLY_TO_EMAIL=
ADMIN_EMAIL=

# --- Gemini AI moderasiya ---
# Bir neçə açar vergüllə: limit dolanda növbəti açara keçir
GEMINI_API_KEYS=
GEMINI_MODEL=
# Hər Gemini çağırışı üçün timeout (ms)
AI_TIMEOUT_MS=20000

# --- Video emalı ---
# Eyni anda neçə AI analizi (I/O-bound, yüksək ola bilər)
AI_CONCURRENCY=6
# Eyni anda neçə ffmpeg encode (CPU-bound). Boşdursa: CPU nüvə sayı / 4
ENCODE_CONCURRENCY=
# Re-encode zamanı ən uzun tərəfin maksimum ölçüsü (px). 1280 = 720p
MAX_VIDEO_DIMENSION=1280
# Bu bitrate-dən aşağı H.264 videolar re-encode olunmadan remux edilir (bit/s)
REMUX_MAX_BITRATE=6000000

# --- Rate limit ---
# auto: Redis qoşuludursa Redis-də (PM2 cluster üçün lazımdır), yoxdursa yaddaşda
# memory: həmişə yaddaşda (tək proses üçün kifayətdir)
RATE_LIMIT_STORE=auto
# Login olmuş istifadəçi üçün dəqiqədə maksimum sorğu
GLOBAL_USER_RATE_LIMIT=300
# Qonaq üçün IP başına dəqiqədə maksimum sorğu (mobil operatorlarda çox istifadəçi eyni IP-ni paylaşır)
GLOBAL_IP_RATE_LIMIT=1200
# Bir IP-dən 10 dəqiqədə maksimum auth cəhdi (login, OTP, qeydiyyat)
AUTH_IP_RATE_LIMIT=50
# Bir provider saatda neçə video yükləyə bilər
UPLOAD_LIMIT_PER_HOUR=20
# Bir provider-in eyni anda emal olunan maksimum video sayı
MAX_PENDING_UPLOADS=3
